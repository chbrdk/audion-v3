# AUDION v3 — environment example

# App
PORT=3006
AUTH_SECRET=replace-with-at-least-32-chars-secret

# Persona / chat upstream (optional)
# NEXT_PERSONA_DATA_SOURCE=auto
# NEXT_PERSONA_BACKEND_INTERNAL_URL=http://api:8000
# NEXT_CHAT_API_INTERNAL_URL=http://chat-api:8001

# Plexon federation (Wave 1) — leave unset for open local fixture mode
# PLEXON_AUTH_URL=http://localhost:3334
# PLEXON_SERVICE_SECRET=shared-secret-min-16-chars
# NEXT_PUBLIC_PLEXON_REGISTER_URL=http://localhost:3334/register

# Product Postgres (projects). Staging: Coolify Internal URL for audion-v3-postgres.
# Leave unset locally to use in-memory project fixtures.
# DATABASE_URL=postgresql://audion:audion@localhost:5432/audion

# Machine Bearer for /api/* when Plexon auth is on (seed scripts / MCP).
# Same value as Settings → API token, or a dedicated Coolify secret.
# AUDION_API_TOKEN=audion_<64-hex>
# AUDION_V3_BASE_URL=https://audion-v3.projects-a.plygrnd.tech

# Plexon demo owner/company for POST /api/projects/:id/sync-plexon without a browser session
# PLEXON_DEMO_OWNER_USER_ID=
# PLEXON_DEMO_COMPANY_ID=

# CHECKION (single-scan deep-links + research fetch-page fallback)
# NEXT_PUBLIC_CHECKION_BASE_URL=https://checkion-v3.projects-a.plygrnd.tech
# CHECKION_API_TOKEN=checkion_<64-hex>
